+
+fn desk_transport(ch: CommandChannel) -> std::io::Result<ExitCode> {
+    use std::io::{BufRead, Write};
+    const REQUEST_LIMIT: usize = 16384;
+    const ALLOWED: &[&str] = &["info", "height", "addresses", "balance", "spendable_balance", "sync", "send", "confirm", "save", "quit", "recovery_info", "value_transfers"];
+    println!("ZEC_DESK_READY");
+    std::io::stdout().flush()?;
+    let mut input = std::io::stdin().lock();
+    loop {
+        let mut line = Vec::new();
+        let count = std::io::Read::take(&mut input, (REQUEST_LIMIT + 1) as u64).read_until(b'\n', &mut line)?;
+        if count == 0 { break; }
+        if count > REQUEST_LIMIT { return Err(std::io::Error::other("request too large")); }
+        let line = std::str::from_utf8(&line).map_err(std::io::Error::other)?;
+        let request = json::parse(line).map_err(std::io::Error::other)?;
+        let cmd = request["command"].as_str().unwrap_or("");
+        if !ALLOWED.contains(&cmd) { return Err(std::io::Error::other("command refused")); }
+        let tokens: Vec<String> = std::iter::once(cmd.to_owned()).chain(request["args"].members().filter_map(|v| v.as_str().map(str::to_owned))).collect();
+        let response = match commands::parse_command_tokens(&tokens) {
+            Ok(command) => {
+                ch.transmitter.send(Request::Command(command)).map_err(std::io::Error::other)?;
+                ch.receiver.recv().map_err(std::io::Error::other)?.unwrap_or_else(|error| error)
+            }
+            Err(error) => format!("Error: {error}"),
+        };
+        println!("ZEC_DESK_JSON:{}", json::object! { "id" => request["id"].clone(), "result" => response }.dump());
+        std::io::stdout().flush()?;
+        if cmd == "quit" { break; }
+    }
+    Ok(ExitCode::SUCCESS)
 }
 
